@using evidencijaRVS.ViewModels
@model PregledlistaViewModel
@{
}
<head>

</head>

<body>
    <div class="container">
        <h2 class="mb-3">Pregledi</h2>
        <form method="get" class="row g-2 mb-4">
            <div class="col-md-2">
                <label class="form-label">Datum od</label>
                <input type="date"name="datumod" value="@Model.Datumod?.ToString("yyyy-MM-dd") class="form-control"></input>
            </div>
            <div class="col-md-2">
                <label class="form-label">Datum do</label>
                <input type="date" name="datumDo" value="@Model.datumdo?.ToString("yyyy-MM-dd") class="form-control"></input>
            </div>
            <div class="col-md-2">
                <label class="form-label">Hitan slucaj</labelclss>
                    <select name="hitanSlucaj" class="form-select">
                        <option value="">Svi</option>
                        <option value="true" selected="@(Model.hitanslucaj == true)">Hitni</option>
                        <option value="false" selected="@(Model.hitanslucaj == false)">Nisu Hitni</option>
                    </select>
            </div>
            <div class=" col-md-3 d-flex align-items-end gap-2">
                <button class="btn btn-primary">Filtriraj</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Ponisti</a>

            </div>
        </form>
        <table class="table table-striped">
            <thead>
                <tr>
                    <Th>Datum</Th>
                    <th>Temperatura</th>
                    <th>Hitan</th>
                    <th>Prioritet</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Pregledi.Any()){
                    <tr><td colspan="5" class="text-center">Nema pregleda za zadate uslove</td></tr>
                }
                @foreach(var p in Model.Pregledi){
                    <tr>
                        <td>@p.datumpregleda.ToString("dd.MM.yyyy")</td>
                        <td>@p.telesna_temperatura</td>
                        <td>@p.dijagnoza</td>
                        <td>@(p.hitanslucaj ? "Da":"Ne")</td>
                        <td>@p.prioritetpregleda</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>